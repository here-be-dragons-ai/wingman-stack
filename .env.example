# Copy to .env and adjust. Every value here has a working default in
# compose.yaml, so an empty .env is fine on this machine.

# ── Gateway ───────────────────────────────────────────────────────────────────

# Host port the wingman platform is published on, bound to 127.0.0.1 only.
# 4242 is also the port the wingman CLI falls back to with no env set at all.
WINGMAN_PORT=4242

# ── Upstream model server ─────────────────────────────────────────────────────

# Base URL of the native mlx-vlm server as seen from inside a container,
# without the /v1 suffix. host.docker.internal reaches the macOS host.
LLM_UPSTREAM_URL=http://host.docker.internal:8888

# Model id the upstream expects. MUST equal MODEL_ALIAS of
# start-mlx_qwen3.8.sh: with mlx-vlm the request model name is the load path,
# so a mismatch triggers a HuggingFace download and fails with HTTP 401.
LLM_MODEL=Qwen3.8-27B-local

# Bearer token forwarded upstream. mlx-vlm ignores it, it only has to be set.
LLM_TOKEN=sk-local

# Where the platform sends requests. Defaults to LLM_UPSTREAM_URL + /v1. Set it
# to the guard when you start the stack with `make up-guard`:
# LLM_URL=http://effort-guard:8080/v1

# Set to 0 to silence the "reasoning effort X -> Y" lines of the effort guard.
LOG_REWRITES=1

# ── Model server profile (used by `make model`) ───────────────────────────────

# auto | lean | balanced | roomy -- see the mlx-qwen38-apple-silicon README.
PROFILE=roomy

# 8 halves the KV cache from 64 to 32 KiB per token and roughly doubles the
# usable context.
KV_BITS=8

# ── Reminder: the CLI needs the matching context window ───────────────────────
#
# scripts/wingman-env.sh exports WINGMAN_CONTEXT_WINDOW=131072, which matches
# PROFILE=roomy with KV_BITS=8. If you change either value above, change it
# there too -- the CLI cannot infer the real budget, and getting it wrong ends
# a session with [METAL] Insufficient Memory rather than with a clean error.
#
#   profile    plain    with KV_BITS=8
#   lean       32768    65536
#   balanced   49152    98304
#   roomy      65536    131072
